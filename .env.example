### SST LeaveFlow - Example environment variables
### Copy this to .env.local and fill in your values.

# Database (PostgreSQL via Drizzle ORM)
# Example: postgresql://user:password@localhost:5432/dbname
DATABASE_URL=

# Clerk (Authentication)
# Get from: https://dashboard.clerk.com
# NOTE: parent approvals use tokenized sha256 links (services/parent/*),
# not sessions — there is no parent JWT/OTP secret.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk UI config
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/redirect
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/redirect

# Email Provider (sst is the only supported provider)
EMAIL_PROVIDER=sst

# --- SMS: Infobip ---
# API key (base64 of "username:password") from https://portal.infobip.com
INFOBIP_BASE_URL=https://api.infobip.com
INFOBIP_API_KEY=
INFOBIP_SENDER_ID=Scaler
# India DLT template & entity IDs (register the template in the Infobip console)
INFOBIP_DLT_CONTENT_TEMPLATE_ID=
INFOBIP_DLT_PRINCIPAL_ENTITY_ID=
# Custom short domain for URL shortening (e.g. scaler.short.gy).
# Must be registered in Infobip (URL Shortening) or messages are rejected.
INFOBIP_CUSTOM_DOMAIN=

# SMS test mode — redirects all SMS to test number in dev
SMS_TEST_MODE=true
SMS_TO_NUMBER=              # Phone number where test SMS are sent

# --- Email: SST service (EMAIL_PROVIDER=sst) ---
# Internal email API used for all transactional mail in production.
EMAIL_SERVICE_URL=
EMAIL_SERVICE_API_KEY=      # X-API-Key for the SST email service

# Slack (Staff notifications)
# Create a Slack app at https://api.slack.com/apps and add the bot token
# The bot needs chat:write scope. Invite it to the channel.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_CHANNEL_ID=C1234567890
# Channel for POC-targeted alerts (requests awaiting POC review).
# Falls back to SLACK_CHANNEL_ID when unset.
SLACK_POC_CHANNEL_ID=

# S3 (Document Storage, private bucket + presigned URLs)
# Reuses AWS_REGION / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (AWS section below).
S3_DOCUMENTS_BUCKET=
S3_DOCUMENTS_PREFIX=sst-hostel-leave-documents
S3_PRESIGNED_URL_EXPIRES_IN=3600

# AWS (shared by S3, SES)
# On EC2 prefer an instance-profile IAM role and leave the static keys
# unset — the SDK default chain applies (see src/lib/s3.ts).
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Outbox worker: no queue or broker. The app records events to the Postgres
# outbox table, and the worker host drains PENDING rows straight from the DB
# on a short interval (systemd timer running `pnpm outbox:drain`). Nothing to
# configure here beyond DATABASE_URL.

# Vercel Cron Jobs
# Generate with: openssl rand -base64 32 (min 32 chars). All /api/cron/*
# routes fail closed (401) when unset OR shorter than 32 chars.
# Rotation: set the new value in the Vercel project env, redeploy, then
# confirm 200s on /api/cron/* — cutover is atomic, no dual-accept window.
# Verify pre-launch that CRON_SECRET is set in Vercel (vercel.json declares
# no env; the scheduler injects Bearer $CRON_SECRET only if configured).
CRON_SECRET=

# QR pass token encryption (AES-256-GCM, key kept OUTSIDE the database)
# 32 random bytes as 64 hex characters. Generate with: openssl rand -hex 32
# Required to mint QR passes and render QR images (email + dashboard).
# Gate scanning is hash-only and works without it.
# DB leak alone must not expose the bearer token: tokenHash (SHA-256) verifies
# scans, tokenEnc (this key) reconstructs the QR. Never log either.
QR_TOKEN_ENC_KEY=
# Active key id stamped into new envelopes (v1:<keyId>:<iv>:<ct>).
# Rotate by setting QR_TOKEN_ENC_KEY_<NEWID>, pointing this at it, and keeping
# the old QR_TOKEN_ENC_KEY_<OLDID> for decrypting historic rows.
QR_TOKEN_ENC_ACTIVE_KEY_ID=k1
# Example historic keys (uncomment when rotating):
# QR_TOKEN_ENC_KEY_K1=
# QR_TOKEN_ENC_KEY_K2=

# App settings
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# Testing (opt-in, never set in production)
# Enables the DB-backed acceptance suite (seeds + deletes rows).
RUN_DB_ACCEPTANCE=
